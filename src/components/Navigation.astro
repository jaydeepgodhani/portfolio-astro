<div
  class="w-screen sticky top-0 backdrop-opacity-99 backdrop-blur-sm z-10 bg-bg/70"
>
  <div class="flex items-center flex-row justify-center">
    <div class="2xl:w-1/2 lg:w-3/4 py-4">
      <nav>
        <ul
          class="w-full relative flex flex-col text-xl items-center lg:flex-row justify-between"
        >
          <li class="">
            <a
              href="/"
              class="border-b-0 no-underline shadow-none hover:shadow-none text-primary"
            >
              <div id="countdown" class="timer-display"></div>
            </a>
          </li>
          <div class="flex flex-row mt-3 justify-center lg:mt-0">
            <li class="mx-4"><a href="/experience">Experience</a></li>
            <li class="mx-4">
              <a href="/projects">Projects</a>
            </li>
            <li class="mx-4">
              <a href="/posts">Posts</a>
            </li>
            <li class="mx-4"><a href="/knowledge">Knowledge</a></li>
            <li>
              <button
                id="themeToggle"
                class="w-auto h-full flex items-center justify-center cursor-pointer pl-3 text-3xl"
              >
                {
                  /* <svg className="h-6 w-full m-2 text-primary" viewBox="0 0 24 24">
                <desc>Theme Switcher Icon</desc>
                <g fill="currentColor">
                  <path d="M12,22 C17.5228475,22 22,17.5228475 22,12 C22,6.4771525 17.5228475,2 12,2 C6.4771525,2 2,6.4771525 2,12 C2,17.5228475 6.4771525,22 12,22 Z M12,20.5 L12,3.5 C16.6944204,3.5 20.5,7.30557963 20.5,12 C20.5,16.6944204 16.6944204,20.5 12,20.5 Z"></path>
                </g>
