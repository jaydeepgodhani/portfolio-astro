<script>
  import { showTime } from "../helpers/utilities";

  function updateTimer() {
    const countdownElement = document.getElementById("countdown");
    if (!countdownElement) return;
    countdownElement.textContent = showTime();
  }

  // Initial render
  updateTimer();

  // Keep it fresh. This script only runs once, so the interval is created once.
  setInterval(updateTimer, 10000);

  // On client-side navigation (View Transitions) the new page's #countdown
  // is an empty element. Fill it right away instead of waiting for the next tick.
  // after-swap fires before the new page is painted, so there's no empty flash.
  document.addEventListener("astro:after-swap", updateTimer);
  document.addEventListener("astro:page-load", updateTimer);

  // --- Theme toggle ---
  // With View Transitions the nav DOM is replaced on every navigation, so a
  // listener attached directly to #themeToggle is lost after the first swap.
  // Event delegation on `document` survives swaps, so it is registered once.
  document.addEventListener("click", (e) => {
    const target = e.target as Element | null;
    if (!target?.closest("#themeToggle")) return;

    const isDark = document.documentElement.classList.contains("dark");
    const next = isDark ? "light" : "dark";
    document.documentElement.classList.toggle("dark", next === "dark");
    try {
      localStorage.setItem("theme", next);
    } catch {}
  });

  // The swap replaces <html>, so re-apply the saved theme to the NEW document
  // before it is painted (avoids a flash of the wrong theme).
  document.addEventListener("astro:after-swap", (e: any) => {
    const theme = localStorage.getItem("theme");
    e.newDocument.documentElement.classList.toggle("dark", theme === "dark");
  });
</script>
