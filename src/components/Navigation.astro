<script>
  import { showTime } from "../helpers/utilities";

  function updateTimer() {
    const countdownElement = document.getElementById("countdown")!;
    if (!countdownElement) return;
    countdownElement.textContent = showTime();
  }
  updateTimer();
  setInterval(updateTimer, 10000);

  // --- Theme toggle ---
  // transition:persist means this component's DOM is NEVER destroyed,
  // so attach the listener ONCE and it lives forever
  function attachThemeToggle() {
    const btn = document.getElementById("themeToggle");
    if (!btn) return;

    // Guard: don't attach twice
    if (btn.dataset.listenerAttached) return;
    btn.dataset.listenerAttached = "true";

    btn.addEventListener("click", () => {
      const isDark = document.documentElement.classList.contains("dark");
      const next = isDark ? "light" : "dark";
      document.documentElement.classList.toggle("dark", next === "dark");
      localStorage.setItem("theme", next);
    });
  }

  // Re-apply theme class after ViewTransitions swaps <html>
  // (swap destroys the <html> classList, persisted nodes stay but html is fresh)
  document.addEventListener("astro:after-swap", () => {
    const theme = localStorage.getItem("theme");
    if (theme === "dark") document.documentElement.classList.add("dark");
  });

  // Attach toggle on first load
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", attachThemeToggle);
  } else {
    attachThemeToggle();
  }
</script>
