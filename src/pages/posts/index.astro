---
import { getCollection } from "astro:content";
import Heading from "../../components/Heading.astro";
import SVG from "../../components/SVG.astro";
import { linkSVG } from "../../helpers/utilities";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
const allPosts = await getCollection("posts");
const allTags: any[] = [];
const content: any[] = [];
allPosts.forEach((e) => {allTags.push(e.data.tags); content.push({id: e.id, ...e.data})});
const allTagsAsSet = new Set(allTags.flat());
const tags = [...allTagsAsSet].sort();
---

<BaseLayout>
  <script>
    // Find all buttons with the `alert` class on the page.
    const spans = document.getElementsByClassName("tag-span");
    for (let item of spans) {
      item.addEventListener("click", () => {
        const value = item.getAttribute("data-value");
        console.log(value);
      });
    }
    const content = 34;
  </script>
  <div class="mt-12 mb-4">
    <Heading text={"Tags"} />
    <div class="mb-4">
      {
        tags.map((val) => (
          <span
            class="tag-span relative inline-block cursor-pointer py-1 px-2 mr-4 rounded-md bg-code-bg"
            data-value={val}
          >
            <span
              class="absolute inset-0 rounded-md pointer-events-none"
              aria-hidden="true"
            />
            <span class="relative z-10">#{val}</span>
          </span>
        ))
      }
    </div>
    <PostList content={content} />
  </div>
</BaseLayout>

