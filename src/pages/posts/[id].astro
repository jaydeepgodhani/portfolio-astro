---
import { getCollection, render } from "astro:content";
import TOC from "../../components/TOC.astro";
import MarkdownLayout from "../../layouts/MarkdownLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const filteredHeadings = headings.filter((h) => h.depth < 3);
---

<MarkdownLayout title={post.data.title}>
  <article
    slot="content"
    class="wrapper transition-opacity duration-300 opacity-100 animate-fade mt-12"
  >
    <div class="flex items-center justify-between">
      <h1>{post.data.title}</h1>
      <span
        >{post.data.tags.map((item: any) => <span>{item}&nbsp;</span>)}{
          post.data.date
        }</span
      >
    </div>
    <hr class="text-secondary border" />
    <br />
    <br />
    <Content />
  </article>
  <TOC headings={filteredHeadings} slot="headings" />
</MarkdownLayout>
