---
import Heading from "../components/Heading.astro";
import Three from "../components/Three.astro";
import { textBlocks } from "../helpers/utilities";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout pageTitle="Projects">
    <div>
      <Heading text={"Corporate Projects"} />
      <div class="ml-8">
        {
          textBlocks.corpprojects.map((item, id) => (
            <div>
              <Three
                header={item[0]}
                body={item[1]}
                footer={item[2]}
              />
            </div>
          ))
        }
      </div>
      <Heading text={"Personal Exploration"} />
      <div class="ml-8">
        {
          textBlocks.personalprojects.map((item, id) => (
            <div>
              <Three
                header={item[0]}
                body={item[1]}
                footer={item[2]}
                link={item[3]}
              />
            </div>
          ))
        }
      </div>
    </div>
</BaseLayout>
