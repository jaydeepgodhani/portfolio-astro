---
import Heading from "../components/Heading.astro";
import Radio from "../components/Radio.astro";
import Three from "../components/Three.astro";
import { textBlocks, textList } from "../helpers/utilities";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout pageTitle="Experience">
  <div>
    <Heading text={"Experience"} />
    <div class="ml-8">
      {
        textBlocks.experience.map((item, id) => (
          <Three header={item[0]} body={item[1]} footer={item[2]} />
        ))
      }
    </div>
    <Heading text={"Skills"} />
    <div class="ml-8">
      <Radio text={textList.skills} />
    </div>
    <Heading text={"Certifications"} />
    <div class="ml-8">
      <Radio text={textList.certifications} />
    </div>
    <Heading text={"Achievements"} />
    <div class="ml-8">
      <Radio text={textList.achievements} />
    </div>
  </div>
</BaseLayout>
