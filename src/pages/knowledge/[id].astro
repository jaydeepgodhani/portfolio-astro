---
import { getCollection, render } from "astro:content";
import TOC from "../../components/TOC.astro";
import MarkdownLayout from "../../layouts/MarkdownLayout.astro";

export async function getStaticPaths() {
  const knowledge = await getCollection("knowledge");
  return knowledge.map((kn) => ({
    params: { id: kn.id },
    props: { kn },
  }));
}

const { kn } = Astro.props;
const { Content, headings } = await render(kn);
const filteredHeadings = headings.filter((h) => h.depth < 3);
console.log(filteredHeadings);
---

<MarkdownLayout title={kn.data.title}>
  <article
    slot="content"
    class="wrapper transition-opacity duration-300 opacity-100 animate-fade mt-12"
  >
    <div class="flex items-center justify-between">
      <h1>{kn.data.title}</h1>
    </div>
    <hr class="text-secondary border" />
    <br />
    <br />
    <Content />
  </article>
  <TOC headings={filteredHeadings} slot="headings" />
</MarkdownLayout>
